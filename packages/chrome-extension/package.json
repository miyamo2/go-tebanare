{
  "name": "@go-tebanare/chrome-extension",
  "version": "0.4.0",
  "private": true,
  "description": "Chrome extension that folds reviewer-agreed Go code in GitHub pull request diffs.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "zip": "node scripts/build.mjs --zip",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "bash scripts/e2e.sh"
  },
  "dependencies": {
    "@go-tebanare/engine": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/chrome": "0.3.0",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
