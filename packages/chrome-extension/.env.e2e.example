# Copy to .env.e2e (ignored by git) and fill in the account that the
# end-to-end tests sign in with. scripts/e2e.sh sources it with
# bash, so wrap a value that has $, `, #, spaces, or quotes in single
# quotes, e.g. E2E_GH_PASSWORD='p@$$w0rd'.
E2E_GH_USER=
E2E_GH_PASSWORD=
# The base32 "setup key" GitHub shows when you add the authenticator app.
E2E_GH_TOTP_SECRET=
