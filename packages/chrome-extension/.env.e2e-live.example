# Copy to .env.e2e-live (ignored by git) and fill in the account that the
# live end-to-end tests sign in with. scripts/e2e-live.sh reads it.
E2E_GH_USERNAME=
E2E_GH_PASSWORD=
# Only for an account with two-factor authentication by authenticator app:
# the base32 secret shown as "setup key" when the app was added.
# E2E_GH_TOTP_SECRET=
