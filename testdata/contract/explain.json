  "yaml": "# The example configuration of plan 4.2.\nversion: 1\n\nfiles:                      # include defaults to [\"**/*.go\"]\n  include: [\"**/*.go\"]\n  exclude: [\"vendor/**\", \"third_party/**\"]\n\npresets:                    # built-in rules, enabled by name (plan 4.5)\n  - getter\n  - noop\n  - iferr:                  # \"name: settings\" changes the settings of a preset\n      names: [err, \"*Err\"]\n\nrules:\n  # Functions and methods (signature patterns, plan 4.3)\n  - id: stringer\n    description: fmt.Stringer implementations need no review\n    func: \"func (_) String() string\"\n\n  - id: gomock\n    description: mocks generated by gomock\n    func: \"func (*Mock*) *\"\n    paths: [\"**/mock_*.go\"]\n\n  - id: generic-repo-finders\n    func: \"func (*Repository[_]) Find*(context.Context, ...) (_, error)\"\n\n  - id: must\n    func: \"func Must[T](T, error) T\"\n\n  # Statements (plan 4.6)\n  - id: tracing\n    stmt:\n      kind: [AssignStmt, DeferStmt]\n      regex:\n        - '^ctx, span := \\w+\\.Start\\(ctx, .+\\)$'\n        - '^defer span\\.End\\(\\)$'\n\n  # Expressions (plan 4.6)\n  - id: debug-log\n    expr:\n      kind: CallExpr\n      regex: '^(log|slog|logger)\\.Debug\\w*\\('\n      not_regex: '(?i)password|token|secret'   # logs that may hold secrets stay visible\n"
